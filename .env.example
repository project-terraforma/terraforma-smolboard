# LangGraph orchestration LLM
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# Git publishing for benchmark data
BENCHMARK_REPO_URL=https://github.com/your-org/your-repo.git
BENCHMARK_REPO_BRANCH=main
BENCHMARK_GIT_USERNAME=your-github-username
BENCHMARK_GIT_TOKEN=your-github-token

# Workspace
BENCHMARK_WORKSPACE_ROOT=C:/path/to/terraforma-smolboard
BENCHMARK_DATA_DIR=website/data
BENCHMARK_COMMIT_MESSAGE=Update benchmark leaderboard data
